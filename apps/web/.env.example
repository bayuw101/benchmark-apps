# Copy to .env.local. The default matches infra/local/docker-compose.yml (dev-only credentials).
DATABASE_URL=postgresql://btb:btb-dev-only@127.0.0.1:15432/btb

# Mock sign-in is on in development; set AUTH_MODE=mock to allow it in a production build too.
# AUTH_MODE=mock

# Signs the session cookie. Required in a production build that uses AUTH_MODE=mock; Auth.js reads the same variable.
# Generate one with: openssl rand -base64 32
# AUTH_SECRET=

# First admin of a new environment (PRD E1.3), used once by `pnpm db:first-admin` after `pnpm db:migrate`.
# A no-op once any admin exists; after that, roles are changed in Admin.
# BTB_FIRST_ADMIN_EMAIL=you@example.com

# Grafana with the BTB dashboards (infra/grafana; compose profile `grafana`). Finished runs link to it (E8.5).
# GRAFANA_URL=http://localhost:3300
