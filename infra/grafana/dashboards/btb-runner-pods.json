{
  "uid": "btb-runner-pods",
  "title": "Runner pod health",
  "description": "CPU, memory, OOM kills and network of k6 runner pods, from kubelet cAdvisor (E10.4/E10.5). Pod restarts need kube-state-metrics, which the local stack doesn't run.",
  "tags": [
    "btb"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "btb-prometheus"
        },
        "query": {
          "query": "label_values(container_memory_working_set_bytes{namespace=~\"perf-.*\"}, namespace)",
          "refId": "namespace"
        },
        "definition": "label_values(container_memory_working_set_bytes{namespace=~\"perf-.*\"}, namespace)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "perf-.*",
        "current": {},
        "options": []
      },
      {
        "name": "run",
        "label": "Run (TestRun)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "btb-prometheus"
        },
        "query": {
          "query": "label_values(container_memory_working_set_bytes{namespace=~\"$namespace\"}, pod)",
          "refId": "run"
        },
        "definition": "label_values(container_memory_working_set_bytes{namespace=~\"$namespace\"}, pod)",
        "regex": "/^(run-\\d+)-/",
        "refresh": 2,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "sort": 2,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Resources",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU used (cores)",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "btb-prometheus"
          },
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",pod=~\"$run-.*\",container!=\"\",container!=\"POD\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "btb-prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "CPU throttled",
      "description": "Share of CFS periods where the pod hit its CPU limit. Sustained throttling skews latency numbers: the generator, not the target, is slow.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "btb-prometheus"
          },
          "expr": "100 * sum by (pod) (rate(container_cpu_cfs_throttled_periods_total{namespace=~\"$namespace\",pod=~\"$run-.*\",container!=\"\",container!=\"POD\"}[$__rate_interval])) / sum by (pod) (rate(container_cpu_cfs_periods_total{namespace=~\"$namespace\",pod=~\"$run-.*\",container!=\"\",container!=\"POD\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "btb-prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Memory used of limit",
      "description": "Working set over the container memory limit. The kernel kills the container at 100%.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "btb-prometheus"
          },
          "expr": "100 * sum by (pod) (container_memory_working_set_bytes{namespace=~\"$namespace\",pod=~\"$run-.*\",container!=\"\",container!=\"POD\"}) / sum by (pod) (container_spec_memory_limit_bytes{namespace=~\"$namespace\",pod=~\"$run-.*\",container!=\"\",container!=\"POD\"} > 0)",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "btb-prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Memory used",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "btb-prometheus"
          },
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=~\"$namespace\",pod=~\"$run-.*\",container!=\"\",container!=\"POD\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "btb-prometheus"
      }
    },
    {
      "type": "row",
      "title": "Failures and network",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "OOM kills in range",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "btb-prometheus"
          },
          "expr": "sum(increase(container_oom_events_total{namespace=~\"$namespace\",pod=~\"$run-.*\",container!=\"\",container!=\"POD\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "btb-prometheus"
      }
    },
    {
