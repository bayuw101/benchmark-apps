{
  "uid": "btb-k6-run",
  "title": "k6 run (native histograms)",
  "description": "One or more BTB runs from k6 remote-write. The run page links here with var-testid and the run's time range (E8.5).",
  "tags": [
    "btb"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "testid",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "btb-prometheus"
        },
        "query": {
          "query": "label_values(k6_vus, testid)",
          "refId": "testid"
        },
        "definition": "label_values(k6_vus, testid)",
        "refresh": 2,
        "multi": true,
        "includeAll": false,
        "sort": 2,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Load",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Virtual users",
      "description": "VUs across runner pods, without the one lease VU per pod. Browser runs also count 1 Chromium VU per pod.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "btb-prometheus"
          },
          "expr": "clamp_min(sum by (testid) (k6_vus{testid=~\"$testid\"}) - count by (testid) (k6_vus{testid=~\"$testid\"}), 0)",
          "legendFormat": "{{testid}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "btb-prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Requests per second",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "btb-prometheus"
          },
          "expr": "sum by (testid) (rate(k6_http_reqs_total{testid=~\"$testid\",scenario!~\"btb-lease|btb-browser\",name!~\"btb-.*\"}[$__rate_interval]))",
          "legendFormat": "{{testid}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "btb-prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Error rate",
      "description": "Share of requests k6 marked as failed (expected_response=false).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "btb-prometheus"
          },
          "expr": "100 * (sum by (testid) (rate(k6_http_reqs_total{testid=~\"$testid\",scenario!~\"btb-lease|btb-browser\",name!~\"btb-.*\",expected_response=\"false\"}[$__rate_interval])) or 0 * sum by (testid) (rate(k6_http_reqs_total{testid=~\"$testid\",scenario!~\"btb-lease|btb-browser\",name!~\"btb-.*\"}[$__rate_interval]))) / sum by (testid) (rate(k6_http_reqs_total{testid=~\"$testid\",scenario!~\"btb-lease|btb-browser\",name!~\"btb-.*\"}[$__rate_interval]))",
          "legendFormat": "{{testid}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "btb-prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "description": "From the k6 native histogram (http_req_duration).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "btb-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (testid) (rate(k6_http_req_duration_seconds{testid=~\"$testid\",scenario!~\"btb-lease|btb-browser\",name!~\"btb-.*\"}[$__rate_interval])))",
          "legendFormat": "p50 {{testid}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "btb-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (testid) (rate(k6_http_req_duration_seconds{testid=~\"$testid\",scenario!~\"btb-lease|btb-browser\",name!~\"btb-.*\"}[$__rate_interval])))",
          "legendFormat": "p95 {{testid}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "btb-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (testid) (rate(k6_http_req_duration_seconds{testid=~\"$testid\",scenario!~\"btb-lease|btb-browser\",name!~\"btb-.*\"}[$__rate_interval])))",
          "legendFormat": "p99 {{testid}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "btb-prometheus"
      }
    },
    {
      "type": "heatmap",
      "title": "Latency heatmap",
      "description": "http_req_duration native histogram, all selected runs.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "btb-prometheus"
          },
          "expr": "sum(rate(k6_http_req_duration_seconds{testid=~\"$testid\",scenario!~\"btb-lease|btb-browser\",name!~\"btb-.*\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        },
        "color": {
          "scheme": "Oranges",
          "mode": "scheme"
        },
        "cellGap": 1,
        "tooltip": {
          "show": true,
          "yHistogram": true
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 6,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "btb-prometheus"
      }
    },
    {
      "type": "row",
      "title": "Per endpoint",
      "id": 7,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
