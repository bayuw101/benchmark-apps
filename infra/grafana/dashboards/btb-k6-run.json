    {
      "type": "table",
      "title": "Endpoints over the time range",
      "description": "Whole-run numbers per request name (k6 `name` tag), when the time range covers the run.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "btb-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (name) (last_over_time(k6_http_req_duration_seconds{testid=~\"$testid\",scenario!~\"btb-lease|btb-browser\",name!~\"btb-.*\"}[$__range])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "btb-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (name) (last_over_time(k6_http_req_duration_seconds{testid=~\"$testid\",scenario!~\"btb-lease|btb-browser\",name!~\"btb-.*\"}[$__range])))",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "btb-prometheus"
          },
          "expr": "sum by (name) (max_over_time(k6_http_reqs_total{testid=~\"$testid\",scenario!~\"btb-lease|btb-browser\",name!~\"btb-.*\"}[$__range]))",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "btb-prometheus"
          },
          "expr": "100 * (sum by (name) (max_over_time(k6_http_reqs_total{testid=~\"$testid\",scenario!~\"btb-lease|btb-browser\",name!~\"btb-.*\",expected_response=\"false\"}[$__range])) or 0 * sum by (name) (max_over_time(k6_http_reqs_total{testid=~\"$testid\",scenario!~\"btb-lease|btb-browser\",name!~\"btb-.*\"}[$__range]))) / sum by (name) (max_over_time(k6_http_reqs_total{testid=~\"$testid\",scenario!~\"btb-lease|btb-browser\",name!~\"btb-.*\"}[$__range]))",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Requests"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Errors"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "p95",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "p95",
              "Value #B": "p99",
              "Value #C": "Requests",
              "Value #D": "Errors",
              "name": "name"
            }
          }
        }
      ],
